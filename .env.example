# Copy this file to .env and fill in real values for local testing.
# In GitHub Actions, set these as repo Secrets instead (Settings > Secrets
# and variables > Actions) — never commit real keys.

# One of these two search providers is required:
SERPER_API_KEY=your_serper_dev_key_here
# BING_API_KEY=your_bing_key_here

# Required — used for classification (relevance + priority scoring)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
